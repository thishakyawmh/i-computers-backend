# MongoDB Atlas connection string (replica set required for transactional orders)
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Generate a unique value with: openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=i-computers-api

# Frontend origins, comma-separated
CORS_ORIGINS=http://localhost:5173

# SMTP / Gmail App Password for password-reset OTP delivery
EMAIL=
PASSWORD=

PORT=3000
